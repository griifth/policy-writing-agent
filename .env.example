# direction_workflow DeepSeek 配置样例（2026-07-22）
# 用法：复制本文件为同目录下的 .env，填入真实密钥。
#   cp .env.example .env        （Windows PowerShell: Copy-Item .env.example .env）
# .env 已被包级 .gitignore 排除，不会被 git 提交。
# 仅生产单（立论/组稿走 DeepSeek）需要；试跑单 agent 直写无需本文件。

# 必填
DEEPSEEK_API_KEY=

# 可选（不填用默认值）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=120
# DEEPSEEK_MAX_TOKENS=
# DEEPSEEK_REASONING_EFFORT=
