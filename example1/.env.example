# 根引擎环境变量示例
#
# 用法：复制本文件为 .env，然后填入真实值。
#   cp .env.example .env
# 注意：
# - .env 【不进仓库】（含真实密钥），请勿提交。
# - 本文件不含任何真实密钥，DEEPSEEK_API_KEY 留空由使用者填写。
# - Windows 上 NOTEBOOKLM_CLI_PATH 可填 notebooklm.exe 的全路径（如 C:\path\to\notebooklm.exe）。
# - DEEPSEEK_MODEL 请填你的 DeepSeek 端点实际提供的模型；本项目现用 deepseek-v4-pro
#   （两个真实 .env 均为此值）；代码仅在 env 缺失时回退 deepseek-chat。

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=600
DEEPSEEK_MAX_TOKENS=12000
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_THINKING_ENABLED=true

# NotebookLM CLI
NOTEBOOKLM_CLI_PATH=notebooklm
NOTEBOOKLM_TIMEOUT_SECONDS=600
