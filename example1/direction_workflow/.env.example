# ============================================================
# direction_workflow DeepSeek 配置样例（2026-07-22 修订）
# 用法：复制本文件为同目录 .env，填入密钥：
#   Mac/Linux:  cp .env.example .env
#   Windows  :  Copy-Item .env.example .env
# .env 已被包级 .gitignore 排除，不会被 git 提交。
# 仅生产单（立论/组稿走 DeepSeek）需要；试跑单 agent 直写不需要本文件。
# 读取优先级：进程环境变量 > .env；.env 位置：包根优先，包上一级兼容。
# ============================================================

# ---- 必填 ----
# DeepSeek 开放平台 API 密钥（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=

# ---- 强烈建议显式填写 ----
# 模型名。代码默认 deepseek-chat，但本项目生产单一直实测使用 deepseek-v4-pro；
# 不填将回落到 deepseek-chat，产稿风格与历史单不一致。
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 可选（不填用括号内默认值）----
# API 地址（默认 https://api.deepseek.com；用兼容代理时才改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次调用超时秒数（默认 120；长文组稿建议 300 以上）
# DEEPSEEK_TIMEOUT_SECONDS=300

# 单次回复 token 上限（默认不限制、由服务端决定；一般不用设）
# DEEPSEEK_MAX_TOKENS=

# 推理力度 max|high|medium|low（默认 max；引擎失败重试时自动逐级降档）
# DEEPSEEK_REASONING_EFFORT=max

# 思考开关 true|false（默认不发送、由服务端决定；空响应降级重试时引擎会自动关思考保正文）
# DEEPSEEK_THINKING_ENABLED=

# ---- 进程级变量（不写在 .env 里，需要时在 shell 里 export/set）----
# DEEPSEEK_ENV_PATH=<另一个 .env 的路径>   指定非默认位置的配置文件
#
# 注：旧引擎的 DEEPSEEK_STORE_REASONING、NOTEBOOKLM_* 等变量本包不读取，无需配置。
